# Production settings for deploy/docker-compose.prod.yml. On the server:
#
#   cd /opt/quake-alert/deploy
#   cp .env.production.example .env && chmod 600 .env
#
# then replace every CHANGE_ME. `.env` is gitignored: never commit it.
# The API and the worker refuse to start in production if a required setting is missing
# or empty (app/core/startup.py), and compose refuses if a variable it needs is unset.

# Lets a plain `docker compose ps` / `logs` / `exec` work in deploy/ (the scripts pass it anyway).
COMPOSE_FILE=docker-compose.prod.yml

# --- Domain and HTTPS (Caddy) ------------------------------------------------------------
API_DOMAIN=api.gempasekitarsaya.my.id
# Let's Encrypt account: expiry and problem notices.
ACME_EMAIL=syarifsanad1@gmail.com

# --- Images (GHCR, built by CI) ----------------------------------------------------------
# "latest" follows main. Pin a commit SHA tag (sha-abc1234) to roll back or hold a version.
IMAGE_TAG=latest
POSTGIS_IMAGE_TAG=latest

# --- PostgreSQL + PostGIS (internal network only) ----------------------------------------
# Passwords go into connection URLs: use hex, which needs no escaping.
#   openssl rand -hex 32
POSTGRES_USER=quake
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=quake_alert

# --- Redis (internal network only, password protected, AOF persistence) -----------------
#   openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME

# DATABASE_URL, REDIS_URL, ENVIRONMENT=production and TRUST_PROXY_HEADERS=true are set by
# docker-compose.prod.yml from the values above; don't set them here.

# --- Logging -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# --- CORS: the frontend on Vercel (apex and www) ------------------------------------------
CORS_ALLOWED_ORIGINS=https://gempasekitarsaya.my.id,https://www.gempasekitarsaya.my.id

# --- Telegram: the PRODUCTION bot, @infogempasekitarbot -----------------------------------
# From @BotFather. Never the *_dev_bot token: set_telegram_webhook.sh refuses one.
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Telegram sends it back on every webhook call; 1-256 chars of A-Z a-z 0-9 _ -
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10.0

# --- Webhook signing secrets (Fernet, comma-separated; the first encrypts) ----------------
# Generate with the api image (or any Python with `cryptography`):
#   docker run --rm ghcr.io/k08e24bryant/quake-alert-api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: README, "Rotating a key". Losing every key makes every stored secret unusable.
WEBHOOK_SECRET_KEYS=CHANGE_ME
WEBHOOK_TIMEOUT_SECONDS=5.0
WEBHOOK_MAX_RESPONSE_BYTES=65536
WEBHOOK_MAX_CONSECUTIVE_FAILURES=10
WEBHOOK_MAX_RETRY_AFTER_SECONDS=300
WEBHOOK_PENDING_VERIFICATION_MAX_AGE_HOURS=24

# --- Freshness (GET /v1/status) ----------------------------------------------------------
INGESTION_STALE_AFTER_MINUTES=5

# --- Notifications -----------------------------------------------------------------------
# Never alert about a quake older than this, retries included.
NOTIFY_MAX_AGE_MINUTES=30
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_RETRY_BACKOFF_SECONDS=5.0
NOTIFY_DUPLICATE_WINDOW_SECONDS=120
NOTIFY_DUPLICATE_DISTANCE_KM=100.0

# --- Rate limits -------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
SUBSCRIPTION_WRITE_RATE_LIMIT_PER_HOUR=5

# --- Redis client and circuit breaker (API) ----------------------------------------------
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_BREAKER_FAILURE_THRESHOLD=3
REDIS_BREAKER_OPEN_SECONDS=30

# --- BMKG ---------------------------------------------------------------------------------
BMKG_BASE_URL=https://data.bmkg.go.id/DataMKG/TEWS/
BMKG_TIMEOUT_SECONDS=10.0
BMKG_MAX_ATTEMPTS=3
BMKG_RETRY_BACKOFF_SECONDS=1.0

# --- Dedup (see README before changing) ---------------------------------------------------
DEDUP_MAX_TIME_DIFF_SECONDS=60
DEDUP_MAX_DISTANCE_KM=50.0
SAME_FEED_REVISION_MAX_KM=100.0

# --- Retention (daily prune, 03:00 UTC) ---------------------------------------------------
INGESTION_RUNS_RETENTION_DAYS=14
INGESTION_RUNS_FAILED_RETENTION_DAYS=90
NOTIFICATION_DELIVERIES_RETENTION_DAYS=30

# --- Cache --------------------------------------------------------------------------------
CACHE_LATEST_TTL_SECONDS=60
CACHE_LIST_TTL_SECONDS=30

# --- Database pool ------------------------------------------------------------------------
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
