# Copy to .env (repo root). Read by docker compose for variable interpolation only;
# application settings live in backend/.env (see backend/.env.example).

POSTGRES_USER=quake
POSTGRES_PASSWORD=quake
POSTGRES_DB=quake_alert

# Host ports. Change these if something else on your machine already uses them.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
