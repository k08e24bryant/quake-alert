# Copy to backend/.env. Read by app.core.config.Settings (pydantic-settings).
# docker compose overrides DATABASE_URL and REDIS_URL to point at its own services.

ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://quake:quake@localhost:5432/quake_alert
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

REDIS_URL=redis://localhost:6379/0

READINESS_TIMEOUT_SECONDS=2.0

# Integration tests only (tests/integration/conftest.py). The test database is
# DROPPED and recreated on every run; never point this at a database you care about.
TEST_DATABASE_URL=postgresql+asyncpg://quake:quake@localhost:5432/quake_alert_test
TEST_REDIS_URL=redis://localhost:6379/15
