# Copy to backend/.env. Read by app.core.config.Settings (pydantic-settings).
# docker compose overrides DATABASE_URL and REDIS_URL to point at its own services.

ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://quake:quake@localhost:5432/quake_alert
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
# Circuit breaker for the API's Redis calls (cache, rate limit): after N consecutive
# failures/timeouts, skip Redis for the open period, then allow one trial call.
REDIS_BREAKER_FAILURE_THRESHOLD=3
REDIS_BREAKER_OPEN_SECONDS=30

# /readyz database check timeout. The Redis check uses REDIS_SOCKET_TIMEOUT_SECONDS.
READINESS_TIMEOUT_SECONDS=2.0

# BMKG Open Data. Failed fetches (5xx, network errors, timeouts) are retried with
# exponential backoff: BMKG_RETRY_BACKOFF_SECONDS * 2**(attempt-1).
BMKG_BASE_URL=https://data.bmkg.go.id/DataMKG/TEWS/
BMKG_TIMEOUT_SECONDS=10.0
BMKG_MAX_ATTEMPTS=3
BMKG_RETRY_BACKOFF_SECONDS=1.0

# Dedup: reports within BOTH thresholds of an existing quake are merged into it.
DEDUP_MAX_TIME_DIFF_SECONDS=60
DEDUP_MAX_DISTANCE_KM=50.0
# Same feed, identical DateTime: a revision only within this distance of the feed's
# previous coordinates. Farther away it is a different quake (new row).
SAME_FEED_REVISION_MAX_KM=100.0

# Daily cleanup of ingestion_runs. The latest successful run per feed is never deleted.
INGESTION_RUNS_RETENTION_DAYS=14
INGESTION_RUNS_FAILED_RETENTION_DAYS=90
# GET /v1/status reports "stale" when some feed had no successful (success or skipped)
# run for this many minutes.
INGESTION_STALE_AFTER_MINUTES=5

# Query API cache. `latest` is invalidated by ingestion; TTLs bound staleness.
CACHE_LATEST_TTL_SECONDS=60
CACHE_LIST_TTL_SECONDS=30

# Rate limit for /v1, per client IP.
RATE_LIMIT_PER_MINUTE=60
# Read the client IP from X-Forwarded-For. Only behind a trusted proxy (Caddy).
TRUST_PROXY_HEADERS=false

# Browser origins allowed to GET /v1/earthquakes* and /v1/status (the frontend), comma-
# separated and exact: scheme://host[:port], no path. Empty: no CORS at all.
# "*" is refused in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Telegram bot (raw Bot API over httpx). Get a token from @BotFather. Never commit it.
# Empty token: deliveries fail without calling Telegram.
TELEGRAM_BOT_TOKEN=
# Sent back by Telegram in X-Telegram-Bot-Api-Secret-Token on POST /v1/telegram/webhook;
# pass the same value as secret_token to setWebhook. 1-256 chars of A-Z a-z 0-9 _ -.
# Empty: the webhook rejects every request.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10.0

# Alerts: only for quakes at most this old (checked when matching AND when sending).
NOTIFY_MAX_AGE_MINUTES=30
# Tries per delivery. Delay before retry n: NOTIFY_RETRY_BACKOFF_SECONDS * 2**(n-1);
# a Telegram 429 waits for its retry_after instead.
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_RETRY_BACKOFF_SECONDS=5.0
# Already alerted for another row within both of these -> the new alert says it may be
# the same event reported by another BMKG feed.
NOTIFY_DUPLICATE_WINDOW_SECONDS=120
NOTIFY_DUPLICATE_DISTANCE_KM=100.0
# Webhook signing secrets are stored encrypted with these Fernet keys (comma-separated;
# the first encrypts, any decrypts). REQUIRED in production. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: put the new key first, keep the old ones after it (see README).
WEBHOOK_SECRET_KEYS=
WEBHOOK_TIMEOUT_SECONDS=5.0
WEBHOOK_MAX_RESPONSE_BYTES=65536
WEBHOOK_MAX_CONSECUTIVE_FAILURES=10
# A receiver's 429 is retried after its Retry-After (seconds or HTTP date), capped at this.
WEBHOOK_MAX_RETRY_AFTER_SECONDS=300
# Daily cleanup: webhook subscriptions that never passed verification, this long after
# they were created.
WEBHOOK_PENDING_VERIFICATION_MAX_AGE_HOURS=24
# Per IP per hour, shared by creating webhook subscriptions, test payloads and
# verification retries. Fails closed: 503 while Redis is unavailable.
SUBSCRIPTION_WRITE_RATE_LIMIT_PER_HOUR=5
# Daily cleanup (03:00 UTC): sent/failed deliveries older than this. Pending: never.
NOTIFICATION_DELIVERIES_RETENTION_DAYS=30

# Integration tests only (tests/integration/conftest.py). The test database is
# DROPPED and recreated on every run; never point this at a database you care about.
TEST_DATABASE_URL=postgresql+asyncpg://quake:quake@localhost:5432/quake_alert_test
TEST_REDIS_URL=redis://localhost:6379/15
