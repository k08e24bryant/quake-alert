# Copy to .env.local. NEXT_PUBLIC_* values are inlined into the browser bundle at build
# time: never put a secret here. On Vercel, set them in the project's environment variables.

# The backend API, without a trailing slash. Its CORS_ALLOWED_ORIGINS must list this
# frontend's origin (http://localhost:3000 in development).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Link to the Telegram bot, shown on "Cara berlangganan".
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/your_bot

# The GitHub repository, for the link to docs/webhooks.md.
NEXT_PUBLIC_REPO_URL=https://github.com/your-user/quake-alert
